# BFF de identificación: origen del backend, solo para código del servidor.
# Ejemplo local; ajustar al host y puerto reales. Sin paths ni credenciales.
BACKEND_URL=http://localhost:8080

# Secreto opaco compartido con Spring Boot, exclusivo del servidor.
# Completar solo en .env.local o en variables privadas del hosting; generarlo fuera de las apps.
BFF_SERVICE_SECRET=

# Configuración exclusivamente local del generador manual de fichas.
# Completar los dos valores en .env.local; no compartir ni versionar ese archivo.
GEMINI_API_KEY=
GEMINI_MODEL=

# Opcional. Ruta absoluta o relativa a la raíz del repositorio; nunca en public/.
FICHAS_DIR=data/fichas

# Opcional para verificaciones humanas. Por defecto usa Google Chrome instalado.
# Ruta absoluta a un ejecutable de Chrome/Chromium; no al perfil personal.
FICHAS_BROWSER_PATH=
