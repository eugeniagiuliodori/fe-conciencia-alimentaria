# Copiar manualmente a .env.integracion.local y completar el secreto de prueba local.
# Solo se aceptan localhost, 127.0.0.1 o ::1 por HTTP, sin path ni credenciales.
BACKEND_URL=http://127.0.0.1:8080
BFF_SERVICE_SECRET=
# Solo test:integracion requiere estas rutas. Archivos locales fuera de public/.
BACKEND_JAR_PATH=./integration/backend/be-conciencia-alimentaria-0.0.1-SNAPSHOT.jar
BACKEND_TEST_CONFIG_PATH=./integration/backend/application-test.yml
# Opcional; puerto local distinto al del JAR (predeterminado: 3100).
INTEGRATION_FRONTEND_PORT=3100
# test:integracion exige TEST_DB_EXPECTED_NAME=conciencia_alimentaria_test y
# TEST_DB_EXPECTED_COMMENT en la terminal; no copiarlos desde .env.local.
